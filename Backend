app.post("/api/reports", (req, res) => {

    const reports = readData("reports.json");

    const report = {
        id: `RPT-${Date.now()}`,
        ...req.body,
        status: "Submitted",
        createdAt: new Date().toISOString()
    };

    reports.push(report);

    fs.writeFileSync(
        path.join(DATA_DIR, "reports.json"),
        JSON.stringify(reports, null, 2)
    );

    res.status(201).json({
        success: true,
        message: "Field report submitted successfully",
        report
    });
});

/* -----------------------------
   RISK CALCULATION
------------------------------ */

app.get("/api/risk", (req, res) => {

    const climate = readData("climate.json");

    if (!climate.length) {
        return res.json({
            success: false,
            message: "No climate data available"
        });
    }

    const latest = climate[climate.length - 1];

    let floodScore = 0;

    if (latest.rainfall >= 100) {
        floodScore += 40;
    } else if (latest.rainfall >= 60) {
        floodScore += 25;
    } else if (latest.rainfall >= 30) {
        floodScore += 10;
    }

    if (latest.soilMoisture >= 80) {
        floodScore += 30;
    } else if (latest.soilMoisture >= 60) {
        floodScore += 20;
    }

    if (latest.riverLevel >= 4) {
        floodScore += 30;
    } else if (latest.riverLevel >= 3) {
        floodScore += 20;
    }

    let level = "LOW";

    if (floodScore >= 70) {
        level = "HIGH";
    } else if (floodScore >= 40) {
        level = "MEDIUM";
    }

    res.json({
        success: true,
        floodRiskScore: floodScore,
        riskLevel: level,
        factors: {
            rainfall: latest.rainfall,
            soilMoisture: latest.soilMoisture,
            riverLevel: latest.riverLevel
        }
    });
});

